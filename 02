package com.company.redis.formatter;

import org.springframework.stereotype.Component;

import java.nio.charset.StandardCharsets;
import java.util.*;
import java.util.stream.Collectors;

@Component
public class RedisResponseFormatter {

    public Object format(Object response) {

        if (response == null) {
            return null;
        }

        /*
         * String Value
         */
        if (response instanceof byte[] bytes) {

            return new String(
                    bytes,
                    StandardCharsets.UTF_8);
        }

        /*
         * List
         */
        if (response instanceof List<?> list) {

            return list.stream()
                    .map(this::format)
                    .collect(Collectors.toList());
        }

        /*
         * Set
         */
        if (response instanceof Set<?> set) {

            return set.stream()
                    .map(this::format)
                    .collect(Collectors.toSet());
        }

        /*
         * Map
         */
        if (response instanceof Map<?, ?> map) {

            Map<Object, Object> result =
                    new LinkedHashMap<>();

            map.forEach((key, value) ->

                    result.put(
                            format(key),
                            format(value)));

            return result;
        }

        /*
         * Array
         */
        if (response instanceof Object[] array) {

            return Arrays.stream(array)
                    .map(this::format)
                    .toList();
        }

        /*
         * Numeric Types
         */
        if (response instanceof Integer ||
                response instanceof Long ||
                response instanceof Double ||
                response instanceof Float ||
                response instanceof Boolean) {

            return response;
        }

        return response.toString();
    }
}
