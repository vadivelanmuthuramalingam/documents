const API_URL =
    "/api/redis/execute";

let lastResponse = "";

loadHistory();

async function executeCommand() {

    const command =
        document
            .getElementById("command")
            .value
            .trim();

    if (!command) {

        alert("Enter command");

        return;
    }

    try {

        const start =
            performance.now();

        const response =
            await fetch(
                API_URL,
                {
                    method: "POST",

                    headers: {
                        "Content-Type":
                            "application/json"
                    },

                    body:
                        JSON.stringify({
                            command: command
                        })
                });

        const result =
            await response.json();

        const end =
            performance.now();

        document
            .getElementById(
                "executionTime")
            .innerText =
            "Execution Time : "
            +
            (end - start)
                .toFixed(2)
            +
            " ms";

        lastResponse =
            JSON.stringify(
                result,
                null,
                4);

        document
            .getElementById(
                "response")
            .textContent =
            lastResponse;

        saveHistory(
            command);

    } catch (e) {

        document
            .getElementById(
                "response")
            .textContent =
            e;
    }
}

function clearCommand() {

    document
        .getElementById(
            "command")
        .value = "";
}

function copyResponse() {

    navigator.clipboard
        .writeText(
            lastResponse);

    alert(
        "Response Copied");
}

function saveHistory(command) {

    let history =
        JSON.parse(
            localStorage.getItem(
                "redisHistory")
            || "[]");

    history.unshift(
        command);

    history =
        [...new Set(history)];

    if (history.length > 30) {

        history =
            history.slice(
                0,
                30);
    }

    localStorage.setItem(
        "redisHistory",
        JSON.stringify(
            history));

    loadHistory();
}

function loadHistory() {

    let history =
        JSON.parse(
            localStorage.getItem(
                "redisHistory")
            || "[]");

    let html = "";

    history.forEach(cmd => {

        html +=
            `<div class="history-item"
                 onclick="selectCommand(this)">
                ${cmd}
             </div>`;
    });

    document
        .getElementById(
            "history")
        .innerHTML =
        html;
}

function selectCommand(element) {

    document
        .getElementById(
            "command")
        .value =
        element.innerText;
}

document
    .getElementById(
        "command")
    .addEventListener(
        "keydown",
        function(e) {

            if (
                e.ctrlKey
                &&
                e.key === "Enter"
            ) {

                executeCommand();
            }
        });
		
		
